# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8082
# Public key of the security microservice (one line, \n escapes) or the path of a file that holds it
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
# Optional: when set, a token must carry exactly this issuer (iss) and this audience (aud); when empty they are not read. The security microservice signs with these two values
JWT_ISSUER=multi-tour-security
JWT_AUDIENCE=multi-tour
# The single MongoDB instance (multi-tour-infra-mongo); the service connects as identity_audit_app, never as the administrator
MONGODB_URI=mongodb://identity_audit_app:@mongo:27017/identity_audit?replicaSet=rs0&authSource=identity_audit
# The cash boxes of a tenant are read from cash-reporting before a change of time zone (HU-IDA-004): its address, and the service token of this service (sub identity-audit-api, issued by the security microservice, never versioned)
CASH_REPORTING_BASE_URL=
SERVICE_TOKEN=
