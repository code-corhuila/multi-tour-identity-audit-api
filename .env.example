# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8082
# Public key of the security microservice (one line, \n escapes) or the path of a file that holds it
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
# Optional: when set, a token must carry exactly this issuer (iss) and this audience (aud); when empty they are not read
JWT_ISSUER=
JWT_AUDIENCE=
# The single MongoDB instance (multi-tour-infra-mongo); the service connects as identity_audit_app, never as the administrator
MONGODB_URI=mongodb://identity_audit_app:@mongo:27017/identity_audit?replicaSet=rs0&authSource=identity_audit
